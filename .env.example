# JARVIS AI 4.0 — Environment Configuration Example

# Operational Mode (live | paper)
JARVIS_MODE=live

# Web Terminal Server Settings
JARVIS_PORT=8501
JARVIS_CORS_ORIGIN=*

# Administrative Security
JARVIS_ADMIN_USER=admin
JARVIS_ADMIN_PASS=ChangeThisToStrongPassword123!
JARVIS_TRADER_PASS=
JARVIS_DEMO_PASS=
JARVIS_SECRET_KEY=

# Trading & Risk Caps
JARVIS_SYMBOLS=XAUUSD,EURUSD,GBPUSD,USDJPY,BTCUSD
JARVIS_MAX_RISK_PCT=0.5
JARVIS_MAX_DAILY_LOSS_PCT=4.0
